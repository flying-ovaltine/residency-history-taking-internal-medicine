{
  "name": "dsh-osce-history-internal-medicine",
  "version": "1.0.0",
  "private": false,
  "description": "住培结业考「病人接诊·病史采集」（内科）陪练：模型先当 SP 病人，说「结束考试」就切考官按官方 100 分表逐项打分。32 例病例脚本、4 份手册、训练记录自动落盘。Residency OSCE history-taking trainer for internal medicine: standardized-patient role-play, then examiner scoring against the official 100-point rubric.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "resources",
    "assets",
    "icon.png",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/selfcheck.mjs",
    "pack": "pnpm pack"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "osce",
    "residency",
    "standardized-patient",
    "medical-education",
    "internal-medicine",
    "住培",
    "规培结业考",
    "病史采集",
    "SP"
  ],
  "author": "杨杨",
  "license": "MIT",
